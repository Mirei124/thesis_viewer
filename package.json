{
  "name": "thesis-viewer",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "replay:evidence": "node --experimental-strip-types scripts/replay-evidence.mjs",
    "build:chrome": "wxt build --browser chrome && node scripts/copy-license.mjs chrome",
    "build:firefox": "wxt build --browser firefox && node scripts/copy-license.mjs firefox",
    "package": "pnpm package:chrome && pnpm package:firefox",
    "package:chrome": "node scripts/package-extension.mjs chrome",
    "package:firefox": "node scripts/package-extension.mjs firefox"
  },
  "dependencies": {
    "@wxt-dev/module-react": "^1.1.0",
    "katex": "^0.18.9",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "wxt": "^0.20.6"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.26.0"
}
